
print("================================")
print("       DATA RATE CALCULATOR")
print("================================")

# Get input values
bits = float(input("Enter number of bits transmitted: "))
time = float(input("Enter transmission time (seconds): "))

# Calculate data rate
if time > 0:
    data_rate = bits / time

    print("\n---------- RESULT ----------")
    print("Data Rate:", data_rate, "bps")
    print("Data Rate:", data_rate / 1000, "Kbps")
    print("Data Rate:", data_rate / 1000000, "Mbps")
else:
    print("Error: Transmission time must be greater than zero.")
